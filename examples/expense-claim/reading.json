  "steps": [
    {"id": "start", "kind": "start", "text": "Start", "lane": "employee"},
    {"id": "s1", "kind": "task", "text": "Fill in claim form", "lane": "employee", "quote": "An employee fills in the claim form and attaches the receipts."},
    {"id": "s2", "kind": "task", "text": "Submit claim to manager", "lane": "employee", "quote": "submits the claim to their line manager"},
    {"id": "s3", "kind": "task", "text": "Check claim against policy", "lane": "manager", "quote": "The line manager checks the claim against the travel policy."},
    {"id": "d1", "kind": "decision", "text": "Within policy?", "lane": "manager", "quote": "If the claim is within policy, the line manager approves it."},
    {"id": "s4", "kind": "task", "text": "Approve claim", "lane": "manager", "quote": "the line manager approves it"},
    {"id": "s5", "kind": "task", "text": "Send claim back with note", "lane": "manager", "quote": "the manager sends the claim back to the employee with a note"},
    {"id": "s6", "kind": "task", "text": "Correct the claim", "lane": "employee", "quote": "the employee corrects the claim and submits it again"},
    {"id": "d2", "kind": "decision", "text": "Over 500 pounds?", "lane": "finance", "quote": "Finance checks whether the claim is over 500 pounds."},
    {"id": "s7", "kind": "task", "text": "Review large claim", "lane": "director", "quote": "The finance director reviews large claims within five working days."},
    {"id": "d3", "kind": "decision", "text": "Signed off?", "lane": "director", "quote": "Claims over 500 pounds need sign-off from the finance director."},
    {"id": "s8", "kind": "task", "text": "Schedule payment", "lane": "finance", "quote": "finance schedules the payment for the next pay run"},
    {"id": "s9", "kind": "task", "text": "Email confirmation to employee", "lane": "system", "quote": "the system emails a confirmation to the employee"},
    {"id": "end", "kind": "end", "text": "End", "lane": "system"}
